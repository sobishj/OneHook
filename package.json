{
  "name": "one-hook",
  "version": "1.0.0",
  "description": "One Hook - Browser Arcade Fishing Game",
  "main": "src/worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create onehook-db",
    "d1:migrate": "wrangler d1 execute onehook-db --local --file=./migrations/0001_initial.sql",
    "d1:migrate:prod": "wrangler d1 execute onehook-db --remote --file=./migrations/0001_initial.sql"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
